        "react-hook-form",
        "@hookform/resolvers",
        "zod",
        "lucide-react"
      ],
      "registryDependencies": ["dialog", "button", "progress"],
      "files": [
        {
          "path": "registry/custom-ui/survey-dialog.tsx",
          "type": "registry:ui",
          "target": "components/custom-ui/survey-dialog.tsx"
        }
      ]
    },
    {
      "name": "steps",
