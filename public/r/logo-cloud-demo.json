rx=\"110\"\n        ry=\"42\"\n        stroke=\"currentColor\"\n        strokeWidth=\"14\"\n        transform=\"rotate(120 128 114)\"\n      />\n      <circle cx=\"128\" cy=\"114\" r=\"18\" fill=\"currentColor\" />\n    </svg>\n  );\n}\n\nfunction ShadcnLogo(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg {...props} viewBox=\"0 0 256 256\" fill=\"none\">\n      <path\n        stroke=\"currentColor\"\n        strokeLinecap=\"round\"\n        strokeWidth=\"25\"\n        d=\"M208 128l-80 80M192 40 40 192\"\n      />\n    </svg>\n  );\n}\n\nfunction ExpoLogo(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg {...props} preserveAspectRatio=\"xMidYMid\" viewBox=\"0 0 256 231\">\n      <path\n        fill=\"currentColor\"\n        d=\"M121 85c2-3 5-4 7-4 1 0 5 1 7 4 16 22 43 67 63 101l26 40c7 8 18 3 24-6s8-15 8-22c0-4-88-168-97-182-9-13-11-16-26-16h-11c-14 0-16 3-25 16C88 30 0 194 0 198c0 7 2 13 8 22s17 14 24 6l26-40c20-34 47-79 63-101Z\"\n      />\n    </svg>\n  );\n}\n\nfunction AstroLogo(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg {...props} fill=\"none\" viewBox=\"0 0 85 107\">\n      <path\n        fill=\"currentColor\"\n        d=\"M27.59 91.136c-4.834-4.418-6.246-13.703-4.232-20.429 3.492 4.241 8.33 5.584 13.342 6.343 7.737 1.17 15.336.732 22.523-2.804.822-.405 1.582-.943 2.48-1.489.675 1.957.85 3.932.615 5.943-.573 4.896-3.01 8.678-6.885 11.545-1.55 1.147-3.19 2.172-4.79 3.253-4.917 3.323-6.247 7.22-4.4 12.888.044.139.084.277.183.614-2.51-1.124-4.344-2.76-5.742-4.911-1.475-2.27-2.177-4.78-2.214-7.498-.019-1.322-.019-2.656-.197-3.96-.434-3.178-1.926-4.601-4.737-4.683-2.884-.084-5.166 1.699-5.771 4.507-.046.216-.113.429-.18.68l.004.001ZM0 69.587s14.314-6.973 28.668-6.973L39.49 29.12c.405-1.62 1.588-2.72 2.924-2.72 1.335 0 2.518 1.1 2.924 2.72L56.16 62.614c17 0 28.668 6.973 28.668 6.973S60.514 3.352 60.467 3.219C59.769 1.261 58.591 0 57.003 0H27.827c-1.588 0-2.718 1.261-3.464 3.22C24.311 3.35 0 69.586 0 69.586Z\"\n      />\n    </svg>\n  );\n}\n\nfunction LinearLogo(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg {...props} fill=\"none\" viewBox=\"0 0 100 100\">\n      <path\n        fill=\"currentColor\"\n        d=\"M1.225 61.523c-.222-.949.908-1.546 1.597-.857l36.512 36.512c.69.69.092 1.82-.857 1.597-18.425-4.323-32.93-18.827-37.252-37.252ZM.002 46.889a.99.99 0 0 0 .29.76L52.35 99.71c.201.2.478.307.76.29 2.37-.149 4.695-.46 6.963-.927.765-.157 1.03-1.096.478-1.648L2.576 39.448c-.552-.551-1.491-.286-1.648.479a50.067 50.067 0 0 0-.926 6.962ZM4.21 29.705a.988.988 0 0 0 .208 1.1l64.776 64.776c.289.29.726.375 1.1.208a49.908 49.908 0 0 0 5.185-2.684.981.981 0 0 0 .183-1.54L8.436 24.336a.981.981 0 0 0-1.541.183 49.896 49.896 0 0 0-2.684 5.185Zm8.448-11.631a.986.986 0 0 1-.045-1.354C21.78 6.46 35.111 0 49.952 0 77.592 0 100 22.407 100 50.048c0 14.84-6.46 28.172-16.72 37.338a.986.986 0 0 1-1.354-.045L12.659 18.074Z\"\n      />\n    </svg>\n  );\n}\n\nfunction SupabaseLogo(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg {...props} viewBox=\"0 0 109 113\" fill=\"none\">\n      <path\n        fill=\"currentColor\"\n        d=\"M63.708 110.284c-2.86 3.601-8.658 1.628-8.727-2.97l-1.007-67.251h45.22c8.19 0 12.758 9.46 7.665 15.874l-43.151 54.347Z\"\n      />\n      <path\n        fill=\"currentColor\"\n        d=\"M45.317 2.071c2.86-3.601 8.658-1.628 8.726 2.97l.442 67.251H9.831c-8.19 0-12.759-9.46-7.665-15.874L45.317 2.071Z\"\n      />\n    </svg>\n  );\n}\n\nfunction ClerkLogo(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg {...props} fill=\"none\" viewBox=\"0 0 128 128\">\n      <circle cx=\"64\" cy=\"64\" r=\"20\" fill=\"currentColor\" />\n      <path\n        fill=\"currentColor\"\n        d=\"M99.572 10.788c1.999 1.34 2.17 4.156.468 5.858L85.424 31.262c-1.32 1.32-3.37 1.53-5.033.678A35.846 35.846 0 0 0 64 28c-19.882 0-36 16.118-36 36a35.846 35.846 0 0 0 3.94 16.391c.851 1.663.643 3.712-.678 5.033L16.646 100.04c-1.702 1.702-4.519 1.531-5.858-.468C3.974 89.399 0 77.163 0 64 0 28.654 28.65