      "content": "import type { SVGProps } from \"react\";\n\nimport {\n  LogoCloud,\n  type LogoCloudItem,\n} from \"@/components/custom-ui/logo-cloud\";\n\nconst iconClassName = \"h-9 w-auto max-w-[7rem] text-foreground\";\n\nconst logos: LogoCloudItem[] = [\n  {\n    name: \"GitHub\",\n    logo: <GithubLogo aria-label=\"GitHub\" className={iconClassName} />,\n  },\n  {\n    name: \"Vercel\",\n    logo: <VercelLogo aria-label=\"Vercel\" className={iconClassName} />,\n  },\n  {\n    name: \"OpenAI\",\n    logo: <OpenAILogo aria-label=\"OpenAI\" className={iconClassName} />,\n  },\n  {\n    name: \"Cursor\",\n    logo: <CursorLogo aria-label=\"Cursor\" className={iconClassName} />,\n  },\n  {\n    name: \"React\",\n    logo: <ReactLogo aria-label=\"React\" className={iconClassName} />,\n  },\n  {\n    name: \"shadcn/ui\",\n    logo: <ShadcnLogo aria-label=\"shadcn/ui\" className={iconClassName} />,\n  },\n  {\n    name: \"Expo\",\n    logo: <ExpoLogo aria-label=\"Expo\" className={iconClassName} />,\n  },\n  {\n    name: \"Astro\",\n    logo: <AstroLogo aria-label=\"Astro\" className={iconClassName} />,\n  },\n  {\n    name: \"Linear\",\n    logo: <LinearLogo aria-label=\"Linear\" className={iconClassName} />,\n  },\n  {\n    name: \"Supabase\",\n    logo: <SupabaseLogo aria-label=\"Supabase\" className={iconClassName} />,\n  },\n  {\n    name: \"Clerk\",\n    logo: <ClerkLogo aria-label=\"Clerk\" className={iconClassName} />,\n  },\n  {\n    name: \"Figma\",\n    logo: <FigmaLogo aria-label=\"Figma\" className={iconClassName} />,\n  },\n];\n\nexport default function LogoCloudDemo() {\n  return <LogoCloud logos={logos} />;\n}\n\nfunction GithubLogo(props: SVGProps<SVGSVGElement>) {\n  return (\n    <svg {...props} viewBox=\"0 0 1024 1024\" fill=\"none\">\n      <path\n        fill=\"currentColor\"\n        fillRule=\"evenodd\"\n        d=\"M512 0C229.12 0 0 229.12 0 512c0 226.56 146.56 417.92 350.08 485.76 25.6 4.48 35.2-10.88 35.2-24.32 0-12.16-.64-52.48-.64-95.36-